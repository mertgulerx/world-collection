<?xml version="1.0" encoding="utf-8"?>
<!--
  Design ledger
  Document: SC3_dead_end_comb.sdf, SDF 1.9, world `SC3` (Dead-end comb).
  Consumer: Gazebo Harmonic (gz-sim 8, sdformat14). Units: SI (metres, radians).
  Frames: x east, y north, z up; world origin as in the plan. Every pose is written out and uses SDF's
    default frame (model: world; link: model; collision and visual: link). Models and links sit at
    their parent origins, so every primitive pose is also its world pose. No relative_to attribute is
    used: Gazebo skips serialising models that carry one.
  Names: each primitive gives a collision `<name>_col` and a visual `<name>_vis` (unique siblings).
  Generator: worldgen 1.0.1; plan docs/plans/worlds/B3-dead-end-comb.md.
  Parameters: none. Seed: none.
  Sources: layout idea (maze and corridor maps) (yan2016benchmarking); layout idea (corridor and maze worlds) (liu2025enhancing).
  Header: copied from simulation/worlds/corridor/corridor.world (SHA-256 2b52a0ad88202c2f2b72f39a9101340ae9b9443c4245356c7a2c6ea11a5c07de).
  Floor: a static box 0.05 m thick with its top face at z = 0 (as the Corridor floor).
  Primitives by role: boundary wall: 4, wall: 14. Collision and visual geometry are identical.
-->
<sdf version="1.9">
  <world name="sc3_dead_end_comb">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.72 0.72 0.72 1</ambient>
      <background>0.95 0.95 0.95 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
